FROM golang:alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /app/mockoidc ./test/cmd/mockoidc

FROM alpine:3.21
RUN apk --no-cache add ca-certificates
COPY --from=builder /app/mockoidc /usr/local/bin/mockoidc
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/mockoidc"]
